{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "charpeni",
  "displayName": "charpeni's Plugins",
  "description": "BB plugins Nicolas Charpentier maintains.",
  "plugins": [
    {
      "id": "dependabot",
      "displayName": "Dependabot",
      "description": "Review GitHub Dependabot alerts by dependency and send grouped fixes to BB agents.",
      "icon": { "url": "./icons/dependabot.svg" },
      "tags": ["github", "security", "interface"],
      "author": { "name": "Nicolas Charpentier", "github": "charpeni" },
      "source": {
        "git": {
          "url": "https://github.com/charpeni/bb-plugins.git",
          "subdir": "plugins/dependabot",
          "range": "^0.1.0",
          "tagPrefix": "dependabot/"
        }
      }
    },
    {
      "id": "disk-usage",
      "displayName": "Disk Usage",
      "description": "See what's taking up disk space on the bb server host, with drill-down by directory.",
      "icon": { "url": "./icons/disk-usage.svg" },
      "tags": ["system", "storage", "interface"],
      "author": { "name": "Nicolas Charpentier", "github": "charpeni" },
      "source": {
        "git": {
          "url": "https://github.com/charpeni/bb-plugins.git",
          "subdir": "plugins/disk-usage",
          "range": "^0.1.0",
          "tagPrefix": "disk-usage/"
        }
      }
    },
    {
      "id": "skills-sh",
      "displayName": "Skills.sh",
      "description": "Install agent skills from skills.sh once, globally for every AI agent bb runs — 1:1 with the npx skills CLI, with drift-aware updates.",
      "icon": { "url": "./icons/skills-sh.svg" },
      "tags": ["skills", "agents", "cli"],
      "author": { "name": "Nicolas Charpentier", "github": "charpeni" },
      "source": {
        "git": {
          "url": "https://github.com/charpeni/bb-plugins.git",
          "subdir": "plugins/skills-sh",
          "range": "^0.1.0",
          "tagPrefix": "skills-sh/"
        }
      }
    },
    {
      "id": "system-monitor",
      "displayName": "System Monitor",
      "description": "Live CPU, memory, disk, load, and uptime statistics with usage history trends for the bb server host.",
      "icon": "ChartColumn",
      "tags": ["system", "monitoring", "interface"],
      "author": { "name": "Nicolas Charpentier", "github": "charpeni" },
      "source": {
        "git": {
          "url": "https://github.com/charpeni/bb-plugins.git",
          "subdir": "plugins/system-monitor",
          "range": "^0.2.0",
          "tagPrefix": "system-monitor/"
        }
      }
    }
  ]
}
